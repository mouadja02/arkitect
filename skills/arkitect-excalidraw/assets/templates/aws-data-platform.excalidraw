    {
      "id": "jEQtnyr7MwwKxcdKxIxrN",
      "x": -264,
      "y": 1408,
      "width": 366.9120000000001,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
