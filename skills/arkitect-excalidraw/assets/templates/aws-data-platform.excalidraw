    {
      "id": "-bHDAQTc3H5xMFuPbYBOB",
      "x": -264,
      "y": 1408,
      "width": 374.304,
      "height": 520,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
